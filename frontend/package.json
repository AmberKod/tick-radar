    "naive-ui": "^2.43.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.46",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.1.4"
