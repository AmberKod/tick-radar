# 复制为 .env，使用本地密码；该文件只包含无效示例值。
TR_ENVIRONMENT=development
TR_LOG_LEVEL=INFO
TR_VERSION=0.1.0
# 单用户访问 Token，仅配置在后端；空值时业务接口拒绝访问。
TR_API_TOKEN=
TR_WEB_PORT=18180
TR_MYSQL_HOST=mysql
TR_MYSQL_PORT=3306
TR_MYSQL_DATABASE=tick_radar
TR_MYSQL_USER=tick_radar
TR_MYSQL_PASSWORD=replace-with-local-password
TR_MYSQL_ROOT_PASSWORD=replace-with-local-root-password
TR_REDIS_URL=redis://redis:6379/0
TR_PROBE_TIMEOUT_SECONDS=1
# 仅启用观察报价，开市时效未验收，不启用自动价格预警。
TR_MARKET_OBSERVATION_ENABLED=true
TR_QUOTE_REFRESH_INTERVAL_SECONDS=30
TR_QUOTE_MAX_SYMBOLS=50
TR_CORS_ORIGINS=["http://127.0.0.1:15173"]
